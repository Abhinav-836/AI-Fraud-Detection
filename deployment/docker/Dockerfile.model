# Training image: writes models + transformer + metadata.json to /app/models.
# docker run --rm -v "$(pwd)/models:/app/models" fraud-detection-train --customers 3000 --days 90
# Kaggle data: add -v "$(pwd)/data/raw/kaggle:/app/data/raw/kaggle" and pass --source kaggle
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_PATH=/app/models

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY src/ ./src/
COPY config/ ./config/

RUN mkdir -p /app/data /app/models /app/logs /app/reports

ENTRYPOINT ["python", "-m", "src.pipelines.training_pipeline"]
CMD ["--customers", "2000", "--days", "60", "--no-feedback"]
